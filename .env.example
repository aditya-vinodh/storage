# Server settings for docker-compose. Copy to .env and fill in what you use.
# These are for whoever runs the server; users set their own choices through the CLI.

# Google sign-in (required for `storage login` in the browser).
# Redirect URIs: http://localhost:8787/auth/google/callback,
# http://localhost:8787/connect/google/callback and
# http://localhost:8787/github/install/google/callback
STORAGE_GOOGLE_CLIENT_ID=
STORAGE_GOOGLE_CLIENT_SECRET=

# Optional: the GitHub App for pull request bindings. Set all of these or none.
# STORAGE_GITHUB_APP_ID=
# STORAGE_GITHUB_APP_SLUG=
# STORAGE_GITHUB_APP_CLIENT_ID=
# STORAGE_GITHUB_APP_CLIENT_SECRET=
# STORAGE_GITHUB_APP_WEBHOOK_SECRET=
# The PEM key on one line, with \n for line breaks:
# STORAGE_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# STORAGE_GITHUB_POLL_INTERVAL_SECONDS=60

# Optional: a GitHub OAuth app for connecting GitHub accounts (github-org: and github-team: grants).
# STORAGE_GITHUB_CLIENT_ID=
# STORAGE_GITHUB_CLIENT_SECRET=
